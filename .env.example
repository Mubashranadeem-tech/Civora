# ============================================================
# CIVORA — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://civora_user:civora_pass@localhost:5432/civora

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# --- Admin Seed Account ---
ADMIN_EMAIL=admin@civora.ai
ADMIN_PASSWORD=Admin@Civora2026!
ADMIN_NAME=Civora Admin

# --- Application URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- AI Provider ---
# Options: openai | aliyun-tongyi | mock
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Alibaba Cloud Tongyi Qianwen (alternative to OpenAI)
# ALIYUN_AI_API_KEY=...
# ALIYUN_AI_MODEL=qwen-max

# --- Email (SMTP) ---
# Options: smtp | console (logs to console in dev)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Civora <noreply@civora.ai>
ADMIN_EMAIL_TO=admin@civora.ai

# --- File Storage ---
# Options: local | aliyun-oss
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_MAX_FILES_PER_PROBLEM=10

# Alibaba Cloud OSS (set STORAGE_PROVIDER=aliyun-oss to use)
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=civora-uploads
ALIYUN_OSS_REGION=oss-ap-southeast-1
ALIYUN_OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
ALIYUN_OSS_CDN_URL=

# --- Social Media Publishing (all optional) ---
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# Facebook / Meta
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# WordPress
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Custom Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Redis (for rate limiting / queues) ---
REDIS_URL=redis://localhost:6379

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
